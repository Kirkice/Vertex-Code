ni'bi{
  "name": "vertex-cli-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": "20.20.2"
  },
  "scripts": {
    "preinstall": "node scripts/bootstrap.mjs",
    "prepare": "husky",
    "install": "node scripts/bootstrap.mjs",
    "install:all": "node scripts/bootstrap.mjs",
    "lint": "turbo lint --log-order grouped --output-logs new-only",
    "check-types": "turbo check-types --log-order grouped --output-logs new-only",
    "test": "turbo test --log-order grouped --output-logs new-only",
    "test:coverage": "turbo test:coverage --log-order grouped --output-logs new-only",
    "format": "turbo format --log-order grouped --output-logs new-only",
    "build": "turbo build --log-order grouped --output-logs new-only",
    "clean": "turbo clean --log-order grouped --output-logs new-only && rimraf .artifacts .turbo",
    "cli": "pnpm --filter @vertex/cli dev",
    "cli:build": "pnpm --filter @vertex/cli build",
    "cli:test": "pnpm --filter @vertex/cli test",
    "cli:pack-smoke": "pnpm --dir apps/cli pack --pack-destination ../../.artifacts && node scripts/cli-tarball-smoke.mjs",
    "knip": "knip --include files"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@dotenvx/dotenvx": "^1.34.0",
    "@roo-code/config-typescript": "workspace:^",
    "@types/node": "^24.1.0",
    "eslint": "^9.27.0",
    "husky": "^9.1.7",
    "knip": "^5.44.4",
    "only-allow": "^1.2.1",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "turbo": "^2.5.6",
    "typescript": "5.8.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "tar-fs": ">=3.1.1",
      "rollup": "4.60.4",
      "vite": "8.0.14",
      "undici": ">=5.29.0",
      "form-data": ">=4.0.4",
      "bluebird": ">=3.7.2",
      "glob": ">=11.1.0",
      "@types/react": "^18.3.23",
      "@types/react-dom": "^18.3.5",
      "zod": "3.25.76"
    }
  }
}
